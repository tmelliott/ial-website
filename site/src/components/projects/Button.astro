---
import { cn } from "./cn";

interface Props {
  type: "primary" | "secondary" | "alternate";
  href?: string;
  class?: string;
  target?: string;
  rel?: string;
}

const { type, href, class: className = "", target, rel } = Astro.props;
const classes = cn(
  "min-h-11 py-2 px-4 cursor-pointer shadow transition flex justify-center items-center rounded border",
  type === "primary" &&
    "border-accent-600 text-accent-600 hover:bg-accent-700 hover:border-accent-700 hover:text-white",
  type === "secondary" && "border-black text-black hover:bg-black hover:text-white",
  type === "alternate" &&
    "border-white text-white hover:bg-white hover:text-black",
  className,
);
---

{
  href ? (
    <a href={href} class={classes} target={target} rel={rel}>
      <slot />
    </a>
  ) : (
    <button type="button" class={classes}>
      <slot />
    </button>
  )
}
