---
import { cn } from "./cn";

interface Props {
  title: string;
  slug: string;
  size?: "sm" | "md" | "lg";
  variant?: "light" | "dark";
}

const { title, slug, size = "md", variant = "light" } = Astro.props;
---

<a
  href={`/keywords/${slug}`}
  class={cn(
    "rounded border px-2 py-1",
    variant === "dark"
      ? "text-gray-300 border-gray-500 hover:bg-gray-500 hover:text-white"
      : "text-gray-600 border-gray-400 hover:bg-gray-200 hover:text-gray-800",
    size === "sm" && "text-xs",
    size === "md" && "text-sm @lg:text-base",
    size === "lg" && "text-lg",
  )}
>
  {title}
</a>
