---
import { responsiveImage } from "../lib/cdnImage";
import MainMenu from "./MainMenu";
import { isMedia, type GeneralGlobal } from "../lib/payload";

interface Props {
  general: GeneralGlobal;
  overlay?: boolean;
}

const { general, overlay = false } = Astro.props;
const logo = isMedia(general.logo) && general.logo.url ? general.logo : undefined;
const logoImage = logo ? responsiveImage(logo, "brand") : undefined;
---

<div
  class:list={[
    "text-white px-4 sm:px-8 py-4 z-50 w-full h-[var(--header-height)] overflow-visible sticky top-0 lg:absolute",
    overlay ? "bg-black lg:bg-transparent lg:shadow-none" : "bg-black shadow-overlay",
  ]}
>
  <div
    class="max-w-(--container-content) mx-auto flex justify-between items-center w-full h-full overflow-visible"
  >
    <a href="/" class="relative h-full aspect-[3]">
      {
        logo && (
          <img
            src={logoImage?.src}
            srcset={logoImage?.srcset}
            sizes={logoImage?.sizes}
            alt="iNZight Analytics Ltd"
            class="absolute inset-0 h-full w-full object-contain object-left"
            decoding="async"
          />
        )
      }
    </a>
    <MainMenu client:load items={general.mainMenu} />
  </div>
</div>
