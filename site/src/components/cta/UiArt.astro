---
// Decoration for the `ui` CTA band (design-system/components/CTA): a faint wireframe of an
// app — window, sidebar, toolbar controls, a dot-plot panel, a floating card and a cursor —
// in white at roughly 3–12% after the layer's 70% opacity. The one colour is the "on" toggle. Drawn on a 1440 × 384 stage; the
// band's mask keeps it clear of the copy.

// Dot plot inside the chart panel: columns of dots, like the logo mark.
const DOT_COLUMNS = [2, 4, 7, 9, 6, 8, 5, 3, 4, 2, 1];
const dots = DOT_COLUMNS.flatMap((n, i) => Array.from({ length: n }, (_, j) => [1046 + i * 22, 318 - j * 18]));
---

<svg class="h-full w-full" viewBox="0 0 1440 384" preserveAspectRatio="xMaxYMid slice">
  <g fill="none" stroke="#fff" stroke-width="1.25" opacity=".7">
    <!-- Main window, bleeding off the bottom and right -->
    <rect x="860" y="36" width="620" height="400" rx="10" fill="#fff" fill-opacity=".025" stroke-opacity=".16" />
    <path d="M860 76H1480" stroke-opacity=".12" />
    <rect x="884" y="50" width="160" height="12" rx="6" fill="#fff" fill-opacity=".06" stroke="none" />

    <!-- Sidebar with nav items, one active -->
    <path d="M1000 76V436" stroke-opacity=".1" />
    <rect x="876" y="96" width="108" height="26" rx="4" fill="#fff" fill-opacity=".07" stroke="none" />
    <rect x="888" y="106" width="64" height="6" rx="3" fill="#fff" fill-opacity=".14" stroke="none" />
    <rect x="888" y="142" width="76" height="6" rx="3" fill="#fff" fill-opacity=".08" stroke="none" />
    <rect x="888" y="172" width="54" height="6" rx="3" fill="#fff" fill-opacity=".08" stroke="none" />
    <rect x="888" y="202" width="70" height="6" rx="3" fill="#fff" fill-opacity=".08" stroke="none" />
    <rect x="888" y="232" width="46" height="6" rx="3" fill="#fff" fill-opacity=".08" stroke="none" />

    <!-- Toolbar: dropdown, segmented control, toggle (on), slider -->
    <rect x="1024" y="92" width="132" height="30" rx="4" stroke-opacity=".14" />
    <rect x="1036" y="104" width="64" height="6" rx="3" fill="#fff" fill-opacity=".1" stroke="none" />
    <path d="M1134 104l6 6 6-6" stroke-opacity=".22" />
    <rect x="1170" y="92" width="150" height="30" rx="4" stroke-opacity=".14" />
    <rect x="1171" y="93" width="50" height="28" rx="3" fill="#fff" fill-opacity=".07" stroke="none" />
    <path d="M1220 92V122M1270 92V122" stroke-opacity=".1" />
    <rect x="1336" y="96" width="44" height="22" rx="11" class="fill-accent-500" fill-opacity=".75" stroke="none" />
    <circle cx="1369" cy="107" r="8" fill="#fff" fill-opacity=".9" stroke="none" />

    <!-- Chart panel with a dot plot and an axis -->
    <rect x="1024" y="140" width="296" height="210" rx="6" fill="#fff" fill-opacity=".02" stroke-opacity=".12" />
    <path d="M1040 332H1304" stroke-opacity=".2" />
    <path d="M1040 332v5M1106 332v5M1172 332v5M1238 332v5M1304 332v5" stroke-opacity=".2" />
    <g fill="#fff" fill-opacity=".11" stroke="none">
      {dots.map(([cx, cy]) => <circle cx={cx} cy={cy} r="6" />)}
    </g>

    <!-- Slider under the chart -->
    <path d="M1040 372H1304" stroke-opacity=".16" stroke-width="3" stroke-linecap="round" />
    <path d="M1040 372H1150" stroke-opacity=".32" stroke-width="3" stroke-linecap="round" />
    <circle cx="1150" cy="372" r="8" fill="#fff" fill-opacity=".2" stroke-opacity=".35" />

    <!-- Side panel: stat tiles -->
    <rect x="1336" y="140" width="130" height="64" rx="6" fill="#fff" fill-opacity=".03" stroke-opacity=".12" />
    <rect x="1350" y="156" width="40" height="6" rx="3" fill="#fff" fill-opacity=".1" stroke="none" />
    <rect x="1350" y="172" width="70" height="16" rx="3" fill="#fff" fill-opacity=".14" stroke="none" />
    <rect x="1336" y="216" width="130" height="64" rx="6" fill="#fff" fill-opacity=".03" stroke-opacity=".12" />
    <rect x="1350" y="232" width="52" height="6" rx="3" fill="#fff" fill-opacity=".1" stroke="none" />
    <path d="M1350 266l18-8 16 4 18-14 18 6 20-10" stroke-opacity=".28" />

    <!-- Floating card / dialog, overlapping the window's left edge -->
    <rect x="716" y="168" width="224" height="132" rx="8" fill="#0c0c0d" fill-opacity=".85" stroke-opacity=".18" />
    <rect x="736" y="190" width="120" height="8" rx="4" fill="#fff" fill-opacity=".16" stroke="none" />
    <rect x="736" y="212" width="180" height="6" rx="3" fill="#fff" fill-opacity=".08" stroke="none" />
    <rect x="736" y="226" width="150" height="6" rx="3" fill="#fff" fill-opacity=".08" stroke="none" />
    <rect x="736" y="256" width="84" height="26" rx="4" stroke-opacity=".3" />
    <rect x="752" y="266" width="52" height="6" rx="3" fill="#fff" fill-opacity=".2" stroke="none" />
    <rect x="832" y="256" width="84" height="26" rx="4" stroke-opacity=".12" />

    <!-- Cursor over the dialog button -->
    <path d="M808 274l0 26 7-6 5 11 5-2-5-11 9 0z" fill="#fff" fill-opacity=".55" stroke="#000" stroke-opacity=".5" stroke-width="1" />
  </g>
</svg>
