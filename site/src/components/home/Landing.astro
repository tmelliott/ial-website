---
import { liveNewsParams, secondsUntilNextAucklandMidnight, todayInAuckland } from "../../lib/newsDate.mjs";
import { findCollection, findGlobal, formatLongDate } from "../../lib/payload";
import { isExternalLink, liveQuickLinks, quickLinkSubtitle, type QuickLink } from "../../lib/quickLinks";

type HomeHero = {
  titleGroup?: { title?: string | null };
};

type HomeApps = {
  apps?: (QuickLink & { id?: string | null })[] | null;
};

if (Astro.cache.enabled) Astro.cache.set({ maxAge: secondsUntilNextAucklandMidnight() });

const { titleGroup } = await findGlobal<HomeHero>("homeHero");
const { apps } = await findGlobal<HomeApps>("homeApps");
const news = await findCollection<{ title: string; slug: string; date: string; newstype?: string | null }>(
  "news",
  liveNewsParams({
    limit: "1",
    sort: "-date",
  }),
);
const latest = news[0];
const links = liveQuickLinks(apps, todayInAuckland());
const title = (titleGroup?.title ?? "").replaceAll("|", "<br/> ");
---

<div data-hero class="flex h-(--hero-h) flex-col">
  <div class="flex flex-1 flex-col justify-end px-4 pt-[var(--header-height)] pb-12 sm:px-8">
    <div class="mx-auto w-full max-w-(--container-content)">
      <h1
        class="max-w-[14ch] text-[clamp(3rem,5.4vw,4.5rem)] font-normal leading-tight"
        set:html={title}
      />
    </div>
  </div>

  <section
    id="hero-strip"
    class="border-t border-white/18 px-4 pt-6 pb-8 sm:px-8"
    aria-label="Latest news and quick links"
  >
    <div class="mx-auto flex w-full max-w-(--container-content) flex-wrap gap-x-12 gap-y-8">
      <div class="flex min-w-0 flex-[1_1_380px] flex-col gap-2">
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="text-xs font-semibold tracking-[0.08em] text-gray-300 uppercase">Latest news</h2>
          <a href="/news" class="text-sm font-semibold text-accent-text-on-dark hover:text-accent-text-on-dark-hover">All news →</a>
        </div>
        {
          latest && (
            <a href={"/news/" + latest.slug} class="flex flex-col gap-1 text-white no-underline hover:text-accent-text-on-dark-hover">
              <span class="text-sm text-gray-300">
                {formatLongDate(latest.date)}
                {latest.newstype ? ` · ${latest.newstype}` : ""}
              </span>
              <span class="text-lg leading-snug">{latest.title}</span>
            </a>
          )
        }
      </div>

      <div class="flex min-w-0 flex-[1.4_1_520px] flex-col gap-2">
        <h2 class="text-xs font-semibold tracking-[0.08em] text-gray-300 uppercase">Quick links</h2>
        <div class="grid grid-cols-[repeat(auto-fill,minmax(190px,1fr))] gap-4">
          {
            links.map((link) => {
              const subtitle = quickLinkSubtitle(link);
              const external = isExternalLink(link.url);
              return (
                <a
                  href={link.url}
                  class="flex min-h-11 items-center justify-between gap-2 rounded border border-white/35 bg-black px-4 py-2 text-white no-underline hover:border-accent-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500"
                >
                  <span class="flex flex-col items-start gap-1">
                    <span class="text-base font-semibold">{link.title}</span>
                    {subtitle && <span class="text-xs text-gray-300">{subtitle}</span>}
                    {link.tag && (
                      <span class="rounded bg-accent-fill px-2 py-1 text-xs font-semibold tracking-wide text-white uppercase">
                        {link.tag}
                      </span>
                    )}
                  </span>
                  {external ? (
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="shrink-0">
                      <path d="M5 11L11 5M6 5h5v5" />
                    </svg>
                  ) : (
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="shrink-0">
                      <path d="M4 8h8M8 4l4 4-4 4" />
                    </svg>
                  )}
                </a>
              );
            })
          }
        </div>
      </div>
    </div>
  </section>
</div>
