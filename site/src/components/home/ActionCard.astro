---
import RichText from "../RichText.astro";
import Button from "./Button";
import { cn } from "./cn";
import type { LexicalData } from "../../lib/payload";
import type { KeywordLink } from "./types";

interface Props {
  title?: string;
  description?: LexicalData | null;
  variant?: "bright" | "feature" | "feature-rev";
  button?: {
    text: string;
    url: string;
  };
  workstreams?: (number | KeywordLink)[];
}

const {
  title,
  description,
  variant = "bright",
  button,
  workstreams,
} = Astro.props;

const keywords = (workstreams ?? []).filter(
  (kw): kw is KeywordLink => typeof kw !== "number",
);
---

<div class="@container rounded shadow text-white h-full overflow-clip">
  <div
    class={cn(
      "p-8 hidden @3xs:flex flex-col gap-4 justify-between h-full",
      variant === "bright" ? "card-gradient-bright" : "card-gradient-feature",
      variant === "feature-rev" && "bg-linear-330",
    )}
  >
    {title && <h4 class="text-lg lg:text-3xl font-semibold">{title}</h4>}
    {
      description && (
        <div
          class={cn(
            "",
            title
              ? "text-sm"
              : "text-lg lg:text-2xl font-semibold pr-12 leading-normal",
          )}
        >
          <RichText data={description} />
        </div>
      )
    }
    {
      keywords.length > 0 ? (
        <div class="mt-4 lg:mt-6">
          <h5 class="text-lg @lg:text-xl font-semibold mb-2">Explore our workstreams</h5>
          <div class="flex flex-wrap gap-2">
            {keywords.map((keyword) => (
              <a
                href={`/keywords/${keyword.slug}`}
                class="rounded border border-white text-white px-3 py-1.5 text-sm @lg:text-base hover:bg-white hover:text-black transition"
              >
                {keyword.title}
              </a>
            ))}
          </div>
        </div>
      ) : (
        button && (
          <Button
            type="alternate"
            href={button.url}
            className="mt-4 lg:mt-6 rounded border-white/75"
          >
            {button.text}
          </Button>
        )
      )
    }
  </div>
  {
    (button || keywords.length > 0) && (
      <div
        class={cn(
          "@3xs:hidden flex h-full flex-col justify-between gap-3 p-4",
          variant === "bright" ? "card-gradient-bright" : "card-gradient-feature",
        )}
      >
        {keywords.length > 0 ? (
          <div>
            <h5 class="text-sm font-semibold mb-2">Our workstreams</h5>
            <div class="flex flex-wrap gap-2">
              {keywords.map((keyword) => (
                <a
                  href={`/keywords/${keyword.slug}`}
                  class="rounded border border-white px-3 py-2 text-sm text-white hover:bg-white hover:text-black transition"
                >
                  {keyword.title}
                </a>
              ))}
            </div>
          </div>
        ) : (
          button && (
            <>
              {title && <h4 class="text-base font-semibold">{title}</h4>}
              <Button
                type="alternate"
                href={button.url}
                className="rounded border-white/75 text-sm"
              >
                {button.text}
              </Button>
            </>
          )
        )}
      </div>
    )
  }
</div>
