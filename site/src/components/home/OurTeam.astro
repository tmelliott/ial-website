---
import BlurImage from "../BlurImage.astro";
import RichText from "../RichText.astro";
import Button from "./Button";
import { findGlobal, isMedia, type LexicalData } from "../../lib/payload";

type HomeTeam = {
  teamTitle: string;
  teamDescription: LexicalData;
  image?: unknown;
  buttonText: string;
};

const { teamTitle, teamDescription, image, buttonText } =
  await findGlobal<HomeTeam>("homeTeam");

const photo = isMedia(image) && image.url ? image : undefined;
---

<div class="px-4 sm:px-8 py-12 lg:py-24 text-black bg-gradient-to-b from-white from-50% lg:from-70% to-surface-alt">
  <div class="max-w-(--container-max) mx-auto grid lg:grid-cols-2 items-center gap-8 lg:gap-12">
    <div class="flex flex-col">
      <h3 class="text-2xl lg:text-5xl mb-4 lg:mb-8">{teamTitle}</h3>

      <div class="mb-8 lg:mb-12 text-xl">
        <RichText data={teamDescription} />
      </div>
      <div class="flex">
        <Button type="secondary" href="/about#team" className="text-sm">
          {buttonText}
        </Button>
      </div>
    </div>
    <div class="overflow-clip">
      {
        photo && (
          <BlurImage
            image={photo}
            alt="The iNZight Team"
            fill={false}
            class="object-contain shadow-card rounded w-full"
            fit="team"
          />
        )
      }
    </div>
  </div>
</div>
