---
import { layoutRegionChart } from "../../data/chartLayout";
import morph from "../../data/morph5.json";

const chart = layoutRegionChart(morph.dots.map((dot) => ({ x: dot[2], y: dot[3] })));
---

<svg
  data-region-chart
  data-radius={chart.radius}
  class="hero-chart block h-auto w-full font-sans"
  viewBox={`0 0 ${chart.width} ${chart.height}`}
  aria-hidden="true"
>
  {
    chart.labels.map((label) => (
      <text x={label.x} y={label.y} text-anchor="middle" fill="#fff" fill-opacity="0.75" font-size="12">
        {label.name}
      </text>
    ))
  }
  {
    chart.dots.map((dot) => (
      <circle cx={dot.x} cy={dot.y} r={chart.radius} fill="#f73c49" />
    ))
  }
  <line
    x1="0"
    x2={chart.width}
    y1={chart.baseline + 3}
    y2={chart.baseline + 3}
    stroke="#fff"
    stroke-opacity="0.3"
  />
</svg>
