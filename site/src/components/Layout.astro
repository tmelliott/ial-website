---
import "../styles/global.css";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import { getGeneral, mediaUrl } from "../lib/payload";
import { socialMetaTags } from "../lib/socialMeta";
import { productionBeacon } from "../lib/webAnalytics";

interface Props {
  title?: string;
  description?: string;
  flush?: boolean;
  image?: string | null;
  imageAlt?: string;
  type?: "website" | "article";
}

const {
  title = "iNZight Analytics Ltd",
  description = "Analytics, research, and data visualisation that make a difference.",
  flush = false,
  image,
  imageAlt,
  type = "website",
} = Astro.props;

const general = await getGeneral();
const socialTags = socialMetaTags({
  title,
  description,
  pathname: Astro.url.pathname,
  origin: Astro.url.origin,
  type,
  image,
  imageAlt,
  fallbackImage: mediaUrl(general.metadata?.image),
  logo: mediaUrl(general.logo),
});

const beacon = productionBeacon(import.meta.env.PROD);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {
      socialTags.map((tag) =>
        tag.property ? (
          <meta property={tag.property} content={tag.content} />
        ) : (
          <meta name={tag.name} content={tag.content} />
        ),
      )
    }
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="font-sans text-black bg-white">
    <Header general={general} overlay={flush} />
    <div class:list={[!flush && "lg:pt-[var(--header-height)]"]}>
      <slot />
    </div>
    <Footer general={general} />
    {
      beacon && (
        <>
          <!-- Cloudflare Web Analytics -->
          <script is:inline type="module" src={beacon.src} data-cf-beacon={beacon.payload} />
          <!-- End Cloudflare Web Analytics -->
        </>
      )
    }
  </body>
</html>
