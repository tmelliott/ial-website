---
import "../styles/global.css";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import { getGeneral } from "../lib/payload";

interface Props {
  title?: string;
  description?: string;
  flush?: boolean;
}

const {
  title = "iNZight Analytics Ltd",
  description = "Analytics, research, and data visualisation that make a difference.",
  flush = false,
} = Astro.props;

const general = await getGeneral();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="font-sans text-black bg-white">
    <Header general={general} />
    <div class:list={[!flush && "pt-[var(--header-height)]"]}>
      <slot />
    </div>
    <Footer general={general} />
  </body>
</html>
