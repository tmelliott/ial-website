---
import BlurImage from "../BlurImage.astro";
import { isMedia } from "../../lib/payload";
import cn from "./cn";
import { extractTextFromRichText } from "./extractText";
import { formatNewsDate, formatNewsRowDate } from "./formatDate";
import type { NewsItem } from "./types";

interface Props {
  newsItem: NewsItem;
  featured?: boolean;
  display?: "card" | "row";
}

const { newsItem, featured = false, display = "card" } = Astro.props;
const galleryItem = newsItem.gallery?.[0];
const banner = isMedia(galleryItem) ? galleryItem : undefined;
const bannerURL = banner?.url ? banner.url : "/news-placeholder.jpg";
const href = "/news/" + newsItem.slug;
---

{
  display === "row" ? (
    <div class="border-t border-gray-200 p-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-6">
        <div class="font-semibold text-gray-700 md:col-span-2 text-sm md:text-base">
          {formatNewsRowDate(newsItem.date)}
        </div>
        {
          newsItem.newstype && (
            <div class="text-gray-400 pb-2 text-sm md:text-base sm:text-right md:text-left">
              {newsItem.newstype}
            </div>
          )
        }
        <div class="sm:col-span-2 md:col-span-3 hover:underline">
          <a href={href}>{newsItem.title}</a>
        </div>
      </div>
    </div>
  ) : (
    <a href={href} class="h-full">
      <div class="@container rounded shadow overflow-clip h-full bg-white">
        <div
          class={cn(
            "flex flex-col @lg:grid @lg:grid-cols-3 @lg:gap-12 h-full @4xl:h-96",
            featured
              ? "bg-gradient-to-bl from-black to-accent-950 text-white"
              : "bg-white text-black",
          )}
        >
          <div class="w-full aspect-[2.5] @lg:aspect-auto relative @lg:order-last">
            <BlurImage
              src={bannerURL}
              alt={newsItem.title}
              class="absolute inset-0 h-full w-full shadow object-cover"
            />
          </div>

          <div class="p-4 @lg:p-8 h-full @lg:col-span-2 flex flex-col @max-lg:justify-between @lg:flex-col-reverse @lg:justify-end">
            <div class="flex flex-col">
              <h4
                class={cn(
                  "text-lg font-semibold mb-2 @lg:mb-4 @lg:mt-8 @lg:text-2xl leading-snug @lg:leading-normal",
                  featured ? "text-white" : "text-black",
                )}
              >
                {newsItem.title}
              </h4>
              <p class="text-sm line-clamp-3 overflow-ellipsis @md:mb-6 flex-1 @lg:line-clamp-6">
                {extractTextFromRichText(newsItem.content)}
              </p>
            </div>

            <div class="flex text-sm gap-4 justify-between @lg:justify-start order-last pt-4 @lg:pt-0">
              <div class={cn(featured ? "text-accent-400" : "text-accent-600")}>
                {formatNewsDate(newsItem.date)}
              </div>
              {
                newsItem.newstype && (
                  <div class={cn(featured ? "text-gray-300" : "text-gray-500")}>
                    {newsItem.newstype}
                  </div>
                )
              }
            </div>
          </div>
        </div>
      </div>
    </a>
  )
}
