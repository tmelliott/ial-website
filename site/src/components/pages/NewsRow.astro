---
import dayjs from "dayjs";
import advancedFormat from "dayjs/plugin/advancedFormat";

dayjs.extend(advancedFormat);

interface Props {
  newsItem: {
    title: string;
    slug: string;
    date: string;
  };
}

const { newsItem } = Astro.props;
---

<div class="border-t border-gray-200 p-4">
  <div class="grid grid-cols-2 md:grid-cols-6">
    <div class="font-semibold text-gray-700 md:col-span-2 text-sm md:text-base">
      {dayjs(newsItem.date).format("Do MMMM YYYY")}
    </div>
    <div class="text-gray-400 pb-2 text-sm md:text-base text-right md:text-left">
      Miscellaneous
    </div>
    <div class="col-span-2 md:col-span-3 hover:underline">
      <a href={`/news/${newsItem.slug}`}>{newsItem.title}</a>
    </div>
  </div>
</div>
