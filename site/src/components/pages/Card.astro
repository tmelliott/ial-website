---
import BlurImage from "../BlurImage.astro";
import { responsiveImage } from "../../lib/cdnImage";
import { buttonClasses, cn } from "./cn";
import { isImage, keywordRefs, sizedImageUrl, type KeywordRef } from "./media";

interface Props {
  title: string;
  image?: unknown;
  banner?: unknown;
  keywords?: (number | KeywordRef)[] | null;
  url: string;
  type: "project" | "app";
  linkType?: "title" | "button";
  variant?: "left" | "right";
  featured?: boolean;
  direction?: "horizontal" | "vertical";
}

const {
  title,
  image,
  banner,
  keywords,
  url,
  type,
  linkType = "title",
  variant = "left",
  featured = false,
  direction = "horizontal",
} = Astro.props;

const titleClass = cn(
  "text-lg @lg:text-xl @4xl:text-3xl font-semibold mb-2 @lg:mb-4 hover:underline",
  featured ? "text-white" : "text-accent-600",
  direction === "vertical" && "mb-4",
);

const bannerSrc = sizedImageUrl(banner, direction === "horizontal" ? "square" : "card");
const logo = isImage(image) && image.url ? image : null;
const logoImage = logo?.url ? responsiveImage(logo.url, "overlay") : undefined;
const tags = keywordRefs(keywords).slice(0, 5);
---

<div
  class={cn(
    "@container rounded shadow overflow-clip bg-white grid grid-cols-4 h-full",
    direction === "horizontal" ? "" : "md:flex md:flex-col",
    type === "app" && "flex flex-col md:grid",
  )}
>
  <div
    class={cn(
      "w-full relative",
      direction === "horizontal"
        ? "@lg:aspect-square @lg:col-span-2 h-full"
        : "md:aspect-[3] lg:aspect-[2]",
      type === "app" && "@max-2xl:aspect-[2]!",
    )}
  >
    {
      bannerSrc && (
        <div class="h-full w-full relative">
          <BlurImage
            src={bannerSrc}
            alt={isImage(banner) ? (banner.alt ?? "") : ""}
          />
        </div>
      )
    }
    {
      logo && (
        <div class="absolute top-0 left-0 w-full h-full flex items-center justify-center">
          <div class="max-w-2/3 max-h-1/2">
            <img
              src={logoImage?.src}
              srcset={logoImage?.srcset}
              sizes={logoImage?.sizes}
              alt={logo.alt ?? "No alt information."}
              width={logo.width ?? undefined}
              height={logo.height ?? undefined}
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      )
    }
  </div>
  <div
    class={cn(
      "p-4 @lg:p-8 h-full col-span-3 @lg:col-span-2 flex flex-col ",
      featured ? "card-gradient-dark text-white" : "bg-white text-black",
      variant === "left" && direction === "horizontal" && "@lg:order-first",
      direction === "vertical" && "md:p-8",
    )}
  >
    {
      linkType === "title" ? (
        <a href={url}>
          <h4 class={titleClass}>{title}</h4>
        </a>
      ) : (
        <div class="flex items-start justify-between">
          <a href={url}>
            <h4 class={titleClass}>{title}</h4>
          </a>
          <a
            href={url}
            class={buttonClasses(
              "primary",
              undefined,
              "text-xs md:text-sm py-1 md:py-2 whitespace-nowrap",
            )}
          >
            Open app
          </a>
        </div>
      )
    }
    <div class="flex-1 pb-4 md:pb-8">
      <div
        class={cn(
          "text-sm @2xl:text-base @4xl:text-lg line-clamp-3 overflow-ellipsis",
          direction === "vertical"
            ? "md:line-clamp-6"
            : "@lg:line-clamp-6 @4xl:line-clamp-[8] @6xl:line-clamp-[10] @lg:mb-6",
        )}
      >
        <slot />
      </div>
    </div>
    {
      keywords && (
        <div
          class={cn(
            "hidden  flex-wrap gap-2",
            direction === "horizontal" ? "@4xl:flex" : "lg:flex",
          )}
        >
          {tags.map((kw) => (
            <a
              href={`/keywords/${kw.slug}`}
              class={cn(
                "rounded border px-2 py-1  text-xs @lg:text-base",
                featured
                  ? "text-gray-300 border-gray-500 hover:bg-gray-500 hover:text-white"
                  : "text-gray-600 border-gray-400 hover:bg-gray-200 hover:text-gray-800",
              )}
            >
              {kw.title}
            </a>
          ))}
        </div>
      )
    }
  </div>
</div>
