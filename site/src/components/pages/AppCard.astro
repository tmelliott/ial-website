---
import RichText from "../RichText.astro";
import Card from "./Card.astro";
import type { KeywordRef } from "./media";
import type { LexicalData } from "../../lib/payload";

interface Props {
  app: {
    slug: string;
    title: string;
    content?: LexicalData | null;
    banner?: unknown;
    logo?: unknown;
    link?: string | null;
    keywords?: (number | KeywordRef)[] | null;
  };
  variant?: "left" | "right";
}

const { app, variant = "left" } = Astro.props;
---

<div id={app.slug}>
  <Card
    title={app.title}
    banner={app.banner}
    image={app.logo}
    keywords={app.keywords}
    url={app.link || "#"}
    type="app"
    linkType="button"
    variant={variant}
  >
    <RichText data={app.content} />
  </Card>
</div>
