---
interface Props {
  href: string;
  type?: "primary" | "secondary" | "alternate";
  class?: string;
}

const { href, type = "primary", class: className = "" } = Astro.props;
const styles = {
  primary:
    "border border-accent-stripe text-accent-text hover:bg-accent-fill hover:border-accent-fill hover:text-white",
  secondary: "border border-black text-black hover:bg-black hover:text-white",
  alternate: "border border-white text-white hover:bg-white hover:text-black",
};
---

<a
  href={href}
  class:list={[
    "min-h-11 py-2 px-4 shadow-card transition flex justify-center items-center rounded",
    styles[type],
    className,
  ]}
>
  <slot />
</a>
