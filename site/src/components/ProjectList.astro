---
import CTABand from "./CTABand.astro";
import ProjectBrowser from "./projects/ProjectBrowser";
import { getPlaceholder } from "../lib/placeholder";
import { findCollection, findGlobal, isMedia, type LexicalData } from "../lib/payload";
import { richTextToHtml } from "../lib/lexical";
import {
  keywordsWithProjects,
  projectKeywords,
  readProjectsListQuery,
  sortProjects,
  type ProjectDoc,
  type ProjectKeyword,
} from "../lib/projects";
import type { MediaImage } from "./home/types";

const projectsPage = await findGlobal<{
  heading?: LexicalData | null;
  workstreams?: (number | ProjectKeyword)[] | null;
}>("projectsPage", { depth: "1" });

const allProjects = sortProjects(
  await findCollection<ProjectDoc>("projects", {
    depth: "2",
    limit: "0",
  }),
);

function slimBanner(banner: ProjectDoc["banner"]): MediaImage | null {
  if (!banner || typeof banner === "number" || !isMedia(banner) || !banner.url) return null;
  return {
    url: banner.url,
    alt: banner.alt,
    mime: banner.mime,
    widths: banner.widths,
    blurDataURL: banner.blurDataURL,
  };
}

const projects = allProjects.map((project) => {
  const banner = slimBanner(project.banner);
  return {
    id: project.id,
    title: project.title,
    slug: project.slug,
    contentHtml: richTextToHtml(project.content),
    banner,
    bannerBlur: getPlaceholder(banner),
    keywords: projectKeywords(project.keywords),
  };
});

const keywords = keywordsWithProjects(allProjects);
const workstreams = projectKeywords(projectsPage.workstreams);
const query = readProjectsListQuery(Astro.url.searchParams);
---

<ProjectBrowser
  client:load
  projects={projects}
  keywords={keywords}
  workstreams={workstreams}
  headingHtml={richTextToHtml(projectsPage.heading)}
  initialKeyword={query.keyword}
  initialPage={query.page}
/>
<CTABand
  variant="hexheat"
  text="Got a project idea?"
  emphasis="Let's work together"
  button="Get in touch"
  href="/contact"
/>
