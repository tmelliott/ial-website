---
import Layout from "../../../components/Layout.astro";
import ProjectList from "../../../components/ProjectList.astro";
import { findGlobal, payloadJson } from "../../../lib/payload";
import { projectPageCount } from "../../../lib/projects";

const raw = Astro.params.page;
const page = Number(raw);
const { totalDocs } = await payloadJson<{ totalDocs: number }>("/api/projects", {
  depth: "0",
  limit: "1",
});
const total = projectPageCount(totalDocs);
if (raw !== String(page) || page < 2 || page > total) {
  return Astro.rewrite("/404");
}
const meta = await findGlobal<{
  metadata?: { title?: string | null; description?: string | null };
}>("projectsPage", { depth: "0" });
---

<Layout
  title={meta.metadata?.title || "Projects - iNZight Analytics Ltd"}
  description={meta.metadata?.description || undefined}
>
  <ProjectList page={page} />
</Layout>
