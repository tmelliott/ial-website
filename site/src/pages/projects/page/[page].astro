---
const raw = Astro.params.page;
const page = Number(raw);
if (!raw || raw !== String(page) || page < 2) {
  return Astro.rewrite("/404");
}

const target = new URL("/projects", Astro.url);
target.searchParams.set("page", String(page));
const keyword = Astro.url.searchParams.get("keyword");
if (keyword) target.searchParams.set("keyword", keyword);
return Astro.redirect(`${target.pathname}${target.search}`);
---
