---
import Layout from "../components/Layout.astro";
import Button from "../components/pages/Button.astro";
---

<Layout>
  <div class="">
    <header
      class="pt-24 px-8 pb-12 lg:pb-32 bg-linear-170 from-15% from-[var(--color-bg-gradient-start)] to-[125%] to-[var(--color-bg-gradient-end)]"
    >
      <div class="max-w-6xl mx-auto">
        <div class="text-gray-400 pb-2 text-3xl">Page Not Found</div>
        <h1 class="text-6xl leading-tight lg:pb-12 text-white">404</h1>
        <p class="text-xl text-white/80 max-w-2xl mt-8">
          The page you're looking for doesn't exist or has been moved.
        </p>
      </div>
    </header>

    <div class="pt-8 px-8 pb-24">
      <div class="max-w-6xl mx-auto">
        <div class="flex flex-col gap-8 items-start">
          <p class="text-lg text-gray-700">
            You can return to the homepage or browse our projects, news, and apps.
          </p>
          <div class="flex flex-wrap gap-4">
            <Button type="primary" href="/">Go to Homepage</Button>
            <Button type="secondary" href="/projects">View Projects</Button>
            <Button type="secondary" href="/news">View News</Button>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
