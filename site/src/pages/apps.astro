---
import CTABand from "../components/CTABand.astro";
import Layout from "../components/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import RichText from "../components/RichText.astro";
import AppCard from "../components/pages/AppCard.astro";
import { findCollection, findGlobal, mediaUrl, type LexicalData, type Media } from "../lib/payload";
import type { KeywordRef } from "../components/pages/media";

type AppDoc = {
  id: number;
  title: string;
  slug: string;
  content?: LexicalData | null;
  banner?: unknown;
  logo?: unknown;
  link?: string | null;
  keywords?: (number | KeywordRef)[] | null;
};

type Metadata = {
  title?: string | null;
  description?: string | null;
  image?: number | Media | null;
};

const page = await findGlobal<{
  metadata?: Metadata | null;
  heading?: string | null;
  description?: LexicalData | null;
}>("appsPage", { depth: "1" });

const general = await findGlobal<{ metadata?: Metadata | null }>("general", {
  depth: "0",
});

const apps = await findCollection<AppDoc>("apps", {
  depth: "2",
  limit: "0",
});

const title =
  page.metadata?.title || general.metadata?.title || "Apps - iNZight Analytics Ltd";
const description =
  page.metadata?.description ||
  general.metadata?.description ||
  "Explore iNZight apps for data analysis and visualisation.";
---

<Layout
  title={title}
  description={description}
  image={mediaUrl(page.metadata?.image)}
  imageAlt={title}
>
  <div class="">
    <PageHeader primary="Taupānga" secondary="iNZight apps">
      <div class="flex flex-wrap gap-2">
        {
          apps.map((app) => (
            <a
              href={`#${app.slug}`}
              class="rounded border border-gray-500 px-2 py-1 text-small! font-normal! text-gray-300! no-underline! hover:bg-gray-500 hover:text-white!"
            >
              {app.title}
            </a>
          ))
        }
      </div>
    </PageHeader>

    <section class="-mt-24 mb-24 flex flex-col gap-8 lg:gap-12 max-w-(--container-content) mx-auto px-4 sm:px-8">
      {
        apps.map((item, index) => (
          <AppCard app={item} variant={index % 2 === 0 ? "left" : "right"} />
        ))
      }
    </section>
    <CTABand variant="ui" text={page.heading ?? "Want better apps?"} button="Get in touch" href="/contact">
      {page.description && <RichText data={page.description} />}
    </CTABand>
  </div>
</Layout>
