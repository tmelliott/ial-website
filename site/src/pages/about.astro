---
import Layout from "../components/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import RichText from "../components/RichText.astro";
import CTABand from "../components/CTABand.astro";
import ActionCard from "../components/pages/ActionCard.astro";
import Button from "../components/pages/Button.astro";
import PersonCard from "../components/pages/PersonCard.astro";
import { hydrateById } from "../components/pages/hydrate";
import { mapPlaces, type MapPlace } from "../lib/ctaMap";
import { richTextToHtml } from "../lib/lexical";
import { findCollection, findGlobal, mediaUrl, type LexicalData, type Media } from "../lib/payload";

type Person = {
  id: number;
  slug: string;
  name: { title?: string | null; first: string; last: string };
  role?: string | null;
  iwi?: string | null;
  photo?: unknown;
};

type Metadata = {
  title?: string | null;
  description?: string | null;
  image?: number | Media | null;
};

const about = await findGlobal<{
  metadata?: Metadata | null;
  heading?: LexicalData | null;
  purpose?: {
    heading?: string | null;
    description?: LexicalData | null;
  } | null;
  pillars?:
    | {
        id?: string | null;
        url: string;
        heading: string;
        description?: LexicalData | null;
      }[]
    | null;
  team?: { heading?: string | null; description?: LexicalData | null } | null;
}>("about", { depth: "2" });

const general = await findGlobal<{ metadata?: Metadata | null }>("general", {
  depth: "0",
});

const collaborators = await findGlobal<{
  feature?: {
    title?: string | null;
    description?: LexicalData | null;
    buttonText?: string | null;
    buttonURL?: string | null;
  } | null;
  places?: MapPlace[] | null;
}>("homeCollaborators", { depth: "1" });

let team = await findCollection<Person>("team", {
  depth: "2",
  limit: "0",
  sort: "order",
});
team = await hydrateById("team", team, (person) => typeof person.photo === "number");

const feature = collaborators.feature;
const title =
  about.metadata?.title || general.metadata?.title || "About - iNZight Analytics Ltd";
const description =
  about.metadata?.description ||
  general.metadata?.description ||
  "Learn about iNZight Analytics Ltd and our mission to provide data analysis and visualisation services.";

const pillars = (about.pillars ?? []).map((pillar) => ({
  ...pillar,
  hasLink: /<a[\s>]/i.test(richTextToHtml(pillar.description)),
}));
---

<Layout
  title={title}
  description={description}
  image={mediaUrl(about.metadata?.image)}
  imageAlt={title}
>
  <div class="">
    <PageHeader primary="Mō mātau" secondary="About">
      {about.heading && <RichText data={about.heading} />}
    </PageHeader>

    <div class="px-4 sm:px-8">
      <section
        class="pt-24 flex flex-col-reverse gap-12 md:grid md:grid-cols-2 lg:gap-24 max-w-(--container-content) mx-auto"
      >
        {
          pillars.length > 0 && (
            <div class="relative z-10 flex flex-col gap-6 lg:gap-8 lg:-mt-40">
              {pillars.map((pillar) => {
                const card = (
                  <div class="flex overflow-hidden rounded border border-gray-100 border-l-0 bg-white shadow-card transition hover:shadow-raised hover:border-gray-200">
                    <div
                      class="w-1 flex-shrink-0 bg-accent-stripe group-hover:bg-accent-700 transition-colors"
                      aria-hidden="true"
                    />
                    <div class="flex-1 p-4 lg:p-8 min-w-0">
                      <h4 class="text-accent-text text-heading-sm mb-2 group-hover:text-accent-text-hover transition-colors">
                        {pillar.hasLink ? (
                          <a href={pillar.url}>{pillar.heading}</a>
                        ) : (
                          pillar.heading
                        )}
                      </h4>
                      <RichText
                        data={pillar.description}
                        class="text-sm text-gray-600 [&_strong]:font-semibold"
                      />
                    </div>
                  </div>
                );
                return pillar.hasLink ? (
                  <div class="group block">{card}</div>
                ) : (
                  <a href={pillar.url} class="group block">
                    {card}
                  </a>
                );
              })}
            </div>
          )
        }
        {
          about.purpose && (
            <div class="pt-8">
              <h2 class="text-heading-md lg:text-heading-xl mb-12">
                {about.purpose.heading}
              </h2>
              <div class="lg:text-lead">
                {about.purpose.description && (
                  <RichText data={about.purpose.description} class="[&_p]:mb-8" />
                )}
              </div>

              <div class="flex flex-col gap-4 mt-24">
                <Button type="primary" href="/contact" class="w-full">
                  Want to get started? Get in touch
                </Button>
                <Button type="secondary" href="/projects" class="w-full">
                  View our projects
                </Button>
              </div>

              {feature && (
                <div class="min-w-0 overflow-hidden mt-12">
                  <ActionCard
                    title={feature.title ?? ""}
                    description={feature.description}
                    button={{
                      text: feature.buttonText ?? "",
                      url: feature.buttonURL ?? "",
                    }}
                    variant="feature-rev"
                  />
                </div>
              )}
            </div>
          )
        }
      </section>
    </div>

    <div class="h-48 bg-gradient-to-b from-white to-surface-alt shadow-card"></div>

    <div class="px-4 sm:px-8">
      <section
        id="team"
        class="pt-24 grid gap-4 sm:gap-8 lg:gap-12 grid-cols-2 md:grid-cols-3 lg:grid-cols-4 max-w-(--container-content) mx-auto pb-24"
      >
        {
          about.team && (
            <div class="col-span-2 flex flex-col gap-4 lg:gap-8 lg:pr-12">
              <h2 class="text-heading-md lg:text-heading-lg">{about.team.heading}</h2>
              <div class="text-lead">
                {about.team.description && <RichText data={about.team.description} />}
              </div>
            </div>
          )
        }

        {
          team.map((person, index) => (
            <a
              href={`/team/${person.slug}`}
              class:list={[
                index === 0 && "lg:col-start-4",
                index === 1 && "lg:col-start-2",
              ]}
            >
              <PersonCard person={person} />
            </a>
          ))
        }
      </section>
    </div>
    <CTABand
      variant="map"
      partners={mapPlaces(collaborators.places)}
      text="Want to work with us?"
      emphasis="Get in touch."
      button="Contact us"
      href="/contact"
    />
  </div>
</Layout>
